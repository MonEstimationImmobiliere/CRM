/* ============================================================
 * POINT D'ENTRÉE UNIQUE DES STYLES GLOBAUX
 *
 * Architecture en couches (cascade ordonnée, type ITCSS) :
 *   1. tokens      → variables CSS (primitives, thèmes, composants, surfaces)
 *   2. base        → reset, typographie, layout racine
 *   3. components  → styles globaux des composants (Element Plus, Ionic)
 *   4. utilities   → classes utilitaires, transitions, responsive
 *
 * Règle : seul ce fichier orchestre les imports. Les fichiers
 * importés ne s'importent jamais entre eux (zéro import circulaire).
 * Les @import doivent rester en tête de fichier (contrainte CSS).
 * ============================================================ */

/* 1. Tokens ------------------------------------------------- */
@import './tokens/primitives.css';
@import './tokens/themes.css';
@import './tokens/components.css';
@import './tokens/surfaces.css';

/* 2. Base --------------------------------------------------- */
@import './base/reset.css';
@import './base/typography.css';
@import './base/layout.css';

/* 3. Components --------------------------------------------- */
@import './components/element-plus.css';
@import './components/element-plus-apple.css';
@import './components/forms.css';
@import './components/dashboard.css';

/* 4. Utilities ---------------------------------------------- */
@import './utilities/helpers.css';
@import './utilities/apple.css';
@import './utilities/transitions.css';
@import './utilities/responsive.css';
