# ─────────────────────────────────────────────
# Variables d'environnement – CRM
# Copier ce fichier en .env et adapter les valeurs
# Seules les variables préfixées VITE_ sont exposées au client
# ─────────────────────────────────────────────

# URL de base de l'API backend
VITE_API_URL=https://monestimationimmobiliere.fr/myimmo/public/api

# Activer le système de mocks (true | false)
# En développement on peut mettre true pour travailler sans backend
VITE_MOCK_ENABLED=false

# Clé API MapTiler (carte interactive)
VITE_MAPTILER_KEY=your_maptiler_key_here

# Titre de l'application (affiché dans l'onglet du navigateur)
VITE_APP_TITLE=CRM Immobilier
